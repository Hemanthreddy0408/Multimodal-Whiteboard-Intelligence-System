# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Multimodal Whiteboard AI"
APP_ENV="development"
SECRET_KEY="your-super-secret-key-change-in-production-minimum-32-chars"
DEBUG=True

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/whiteboard_ai
# Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/whiteboard_ai
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/whiteboard_ai"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="diagrams"

# ─── AI APIs (get from platform websites) ────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Google AI: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="AIza..."

# Ollama (local — no key needed, just run: ollama run llama3)
OLLAMA_BASE_URL="http://localhost:11434"

# ─── AI Models ────────────────────────────────────────────────────────────────
# Download SAM checkpoint:
# wget https://dl.fbaipublicfiles.com/segment_anything/sam_vit_h_4b8939.pth -P ./models/
SAM_CHECKPOINT_PATH="./models/sam_vit_h_4b8939.pth"
SAM_MODEL_TYPE="vit_h"

# HuggingFace models (auto-downloaded on first run)
TROCR_MODEL="microsoft/trocr-large-handwritten"
DINOV2_MODEL="facebook/dinov2-large"

# ─── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
